<section class="section" id="questionbank"><div class="panel"><h2>Question Bank</h2><p class="muted">নিজের প্রশ্ন, উত্তর ও বিষয়ভিত্তিক অনুশীলন সংরক্ষণ করুন।</p><label>Subject<input id="qbSubject" class="field"></label><label>Question<textarea id="qbQuestion" class="field"></textarea></label><label>Answer / explanation<textarea id="qbAnswer" class="field"></textarea></label><div class="row"><button class="btn" onclick="saveQuestionBank()">Save question</button><button class="btn secondary" onclick="exportQuestionBank()">Export JSON</button></div><div id="qbList"></div></div></section>
<section class="section" id="notes"><div class="panel"><h2>AI Notes / Notes</h2><label>Title<input id="noteTitle" class="field"></label><label>Subject<input id="noteSubject" class="field"></label><label>Content<textarea id="noteContent" class="field" rows="5"></textarea></label><div class="row"><button class="btn" onclick="saveNote()">Save note</button><button class="btn secondary" onclick="loadNotes()">Refresh</button><button class="btn secondary" onclick="printContent('notesList')">PDF / Print</button></div><p class="status" id="notesStatus"></p><div id="notesList"></div></div></section>
<section class="section" id="flashcards"><div class="panel"><h2>Flashcards / Memory Architect</h2><label>Subject<input id="fcSubject" class="field"></label><label>Front / Question<textarea id="fcFront" class="field"></textarea></label><label>Back / Answer<textarea id="fcBack" class="field"></textarea></label><button class="btn" onclick="saveCard()">Save flashcard</button><p id="fcStatus" class="status"></p><div id="cardList"></div><p class="muted">Review buttons schedule a simple next-review date; forgetting radar is an estimate, not a medical or cognitive measurement.</p></div></section>
<section class="section" id="library"><div class="panel"><h2>Personal Library</h2><label>Title<input id="libTitle" class="field"></label><label>Type<select id="libType" class="field"><option>resource</option><option>book</option><option>link</option><option>summary</option></select></label><label>Content / URL<textarea id="libContent" class="field"></textarea></label><button class="btn" onclick="saveLibrary()">Save item</button><p id="libStatus" class="status"></p><div id="libraryList"></div></div></section>
<section class="section" id="knowledge"><div class="panel"><h2>Knowledge System</h2><label>Concept<input id="concept" class="field"></label><label>Prerequisite<input id="prereq" class="field"></label><label>Related concepts<input id="related" class="field"></label><label>Notes<textarea id="conceptNotes" class="field"></textarea></label><button class="btn" onclick="saveConcept()">Save concept</button><button class="btn secondary" onclick="exportKnowledge()">Export JSON</button><p id="knowledgeStatus" class="status"></p><div id="conceptList"></div></div></section>
<section class="section" id="exam"><div class="panel"><h2>Exam Center / Mistake Log</h2><div class="row"><label>Subject<input id="examSubject" class="field"></label><label>Exam name<input id="examName" class="field"></label></div><div class="row"><label>Score<input id="examScore" type="number" class="field"></label><label>Total marks<input id="examTotal" type="number" class="field"></label></div><label>Mistake / weak area<textarea id="examMistake" class="field"></textarea></label><label>Correction / next action<textarea id="examCorrection" class="field"></textarea></label><button class="btn" onclick="saveExam()">Save exam log</button><p id="examStatus" class="status"></p><div id="examList"></div></div></section>
<section class="section" id="planner"><div class="panel"><h2>Study / Revision Planner</h2><label>Task<input id="taskTitle" class="field"></label><div class="row"><label>Subject<input id="taskSubject" class="field"></label><label>Type<select id="taskType" class="field"><option>study</option><option>revision</option><option>exam</option><option>homework</option></select></label><label>Due date<input id="taskDate" type="date" class="field"></label></div><label>Notes<textarea id="taskNotes" class="field"></textarea></label><button class="btn" onclick="saveTask()">Add task</button><p id="taskStatus" class="status"></p><div id="taskList"></div></div></section>
<section class="section" id="toolbox"><div class="panel"><h2>Study Toolbox</h2><h3>Calculator</h3><input id="calc" class="field" placeholder="Example: (12+8)*3/2"><button class="btn" onclick="calculate()">Calculate</button><p id="calcResult" class="status"></p><hr><h3>Focus timer</h3><div id="timer" style="font-size:34px;font-weight:800">25:00</div><div class="row"><input id="timerMins" class="field" type="number" min="1" max="180" value="25"><button class="btn" onclick="startTimer()">Start</button><button class="btn secondary" onclick="pauseTimer()">Pause</button><button class="btn secondary" onclick="resetTimer()">Reset</button></div><p id="timerStatus" class="status"></p><hr><h3>Unit converter</h3><div class="row"><input id="unitValue" class="field" type="number" placeholder="Value"><select id="unitFrom" class="field"><option value="km">km</option><option value="m">m</option><option value="cm">cm</option><option value="kg">kg</option><option value="g">g</option><option value="l">L</option><option value="ml">mL</option></select><select id="unitTo" class="field"><option value="m">m</option><option value="km">km</option><option value="cm">cm</option><option value="g">g</option><option value="kg">kg</option><option value="ml">mL</option><option value="l">L</option></select><button class="btn" onclick="convertUnits()">Convert</button></div><p id="unitResult" class="status"></p></div></section>
<section class="section" id="research"><div class="panel"><h2>Web Research</h2><p class="muted">Live search uses the configured provider adapter. Add a compatible search API key and endpoint in Render Environment Variables.</p><label>Research question<input id="researchQ" class="field"></label><button class="btn" onclick="liveResearch()">Search web</button><button class="btn secondary" onclick="askResearchAI()">Ask AI without live search</button><p id="researchStatus" class="status"></p><div id="researchOutput" class="item"></div></div></section>
<section class="section" id="dashboard"><div class="panel"><h2>Learning Dashboard</h2><button class="btn secondary" onclick="refreshDashboard()">Refresh</button><div id="dashboardData" class="grid"></div><h3>Tasks</h3><div id="dashboardTasks"></div><h3>Memory review due</h3><div id="dueCards"></div></div></section>
<section class="section" id="settings"><div class="panel"><h2>Settings</h2><label>Preferred language<select id="prefLang" class="field"><option>Bengali</option><option>English</option><option>Hindi</option><option>Urdu</option><option>Arabic</option></select></label><label>Daily study goal (minutes)<input id="goalMins" class="field" type="number" min="10" max="720" value="120"></label><button class="btn" onclick="saveSettings()">Save settings</button><p id="settingsStatus" class="status"></p><p class="muted">API keys are never entered here; keep them in Render Environment Variables.</p></div></section>
</main></div></div><nav id="bottomNav" class="bottom no-print"></nav><div class="watermark">Learn With Utsab</div>
<script>
const $=id=>document.getElementById(id);const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const nav=[['home','Home'],['offline','Offline Study Mode'],['ai','Utsab AI'],['research','Web Research'],['questions','Previous Questions'],['questionbank','Question Bank'],['study','Study Pack'],['knowledge','Knowledge System'],['exam','Exam Center'],['planner','Study Planner'],['notes','AI Notes'],['flashcards','Flashcards / Memory'],['library','Personal Library'],['toolbox','Study Toolbox'],['dashboard','Dashboard'],['settings','Settings'],['auth','Profile / Login']];
const featureText={'offline':'Works without API/internet for saved study tools','ai':'Multilingual tutor','research':'Live search provider needed','questions':'Practice questions','questionbank':'Save and organize your own questions','study':'Notes, MCQs, revision','knowledge':'Prerequisites and concept map','exam':'Scores and mistakes','planner':'Tasks and revision dates','notes':'Save and print notes','flashcards':'Spaced review','library':'Save resources','toolbox':'Calculator, timer, units','dashboard':'Study progress','settings':'Preferences and security','auth':'Student / Teacher account'};
let token=localStorage.getItem('usbk_token')||'',user=null,authMode='login',lastAnswer='',chat=[],timerHandle=null,secondsLeft=1500,founder=[],pendingAttachments=[];
function show(id){document.querySelectorAll('.section').forEach(x=>x.classList.toggle('active',x.id===id));document.querySelectorAll('[data-nav]').forEach(x=>x.classList.toggle('active',x.dataset.nav===id));window.scrollTo({top:0,behavior:'smooth'});if(id==='notes')loadNotes();if(id==='flashcards')loadCards();if(id==='library')loadLibrary();if(id==='knowledge')loadKnowledge();if(id==='planner')loadTasks();if(id==='exam')loadExams();if(id==='dashboard')refreshDashboard();if(id==='settings')loadSettings();}
function makeNav(){const side=$('sideNav'),bottom=$('bottomNav');side.innerHTML=nav.map(([id,l])=>`<button class="nav ${id==='home'?'active':''}" data-nav="${id}" onclick="show('${id}')">${l}</button>`).join('');bottom.innerHTML=nav.filter(([id])=>['home','ai','study','planner','notes','dashboard'].includes(id)).map(([id,l])=>`<button class="${id==='home'?'active':''}" data-nav="${id}" onclick="show('${id}')">${l}</button>`).join('');$('features').innerHTML=nav.filter(([id])=>id!=='home').map(([id,l])=>`<button class="feature" onclick="show('${id}')"><strong>${l}</strong><span class="muted">${featureText[id]||''}</span></button>`).join('');}
async function api(url,opt={}){const headers={'Content-Type':'application/json',...(opt.headers||{})};if(token)headers.Authorization='Bearer '+token;let r;try{r=await fetch(url,{...opt,headers,signal:opt.signal||AbortSignal.timeout(50000)});}catch(e){if(!navigator.onLine)throw Error('ইন্টারনেট নেই। Offline Study Mode ব্যবহার করুন; AI/Cloud API পরে চেষ্টা করুন।');if(e.name==='TimeoutError')throw Error('Request timeout—কিছুক্ষণ পরে আবার চেষ্টা করুন।');throw Error('সার্ভারের সঙ্গে সংযোগ হয়নি। Backend URL/Render logs পরীক্ষা করুন।');}const d=await r.json().catch(()=>({error:'Unexpected server response'}));if(!r.ok)throw Error(d.error||`Request failed (${r.status})`);return d;}
function renderAuth(){$('registerFields').classList.toggle('hide',authMode!=='register');$('authSubmit').textContent=authMode==='register'?'Create account':'Login';}
$('authForm').addEventListener('submit',async e=>{e.preventDefault();const f=new FormData(e.currentTarget),data={emailOrPhone:f.get('emailOrPhone'),password:f.get('password')};if(authMode==='register')Object.assign(data,{name:f.get('name'),role:f.get('role'),className:f.get('className'),school:f.get('school')});$('authStatus').textContent='Working...';try{const d=await api('/api/auth/'+(authMode==='register'?'register':'login'),{method:'POST',body:JSON.stringify(data)});token=d.token;localStorage.setItem('usbk_token',token);user=d.user;userUI();$('authStatus').textContent='Signed in.';show('home');refreshDashboard();}catch(e){$('authStatus').textContent=e.message;}});
function userUI(){$('userBadge').textContent=user?`${user.name} · ${user.role}`:'Guest';$('authButton').textContent=user?'Account':'Login / Register';$('logoutBtn').classList.toggle('hide',!user);if(user){$('profileName').value=user.name||'';$('profileClass').value=user.className||'';$('profileSchool').value=user.school||'';}}
function needLogin(){if(!user){show('auth');return false;}return true;}
async function boot(){makeNav();renderAuth();const resetToken=new URLSearchParams(location.search).get('resetToken');if(resetToken){show('auth');confirmPasswordResetFromPrompt(resetToken);history.replaceState({},'',location.pathname);}try{if(token){const d=await api('/api/auth/me');user=d.user;}}catch{token='';localStorage.removeItem('usbk_token');}userUI();const saved=localStorage.getItem('usbk_founder');founder=saved?JSON.parse(saved):[];renderFounder();try{const h=await fetch('/api/health').then(r=>r.json());$('dashboardData').innerHTML=`<div class="item">Database: ${esc(h.database)}</div><div class="item">AI: ${h.aiConfigured?'configured':'needs provider settings'}</div><div class="item">Live search: ${h.liveSearchConfigured?'configured':'needs provider settings'}</div><div class="item">Password reset email: ${h.passwordResetConfigured?'configured':'needs SMTP settings'}</div><div class="item">Offline: available for local study tools</div>`;}catch{}if(user){loadChat();refreshDashboard();}}
async function logout(){token='';user=null;localStorage.removeItem('usbk_token');userUI();$('chatBox').innerHTML='';show('home');}
async function requestReset(){const emailOrPhone=document.querySelector('[name=emailOrPhone]').value.trim();if(!emailOrPhone)return $('authStatus').textContent='আগে Email লিখুন। Phone-only accounts need an email/SMS reset provider.';try{const d=await api('/api/auth/password-reset/request',{method:'POST',body:JSON.stringify({emailOrPhone})});$('authStatus').textContent=d.message||'যদি অ্যাকাউন্টটি থাকে, reset instructions পাঠানো হবে।';}catch(e){$('authStatus').textContent=e.message;}}
async function confirmPasswordResetFromPrompt(raw){const newPassword=prompt('নতুন password লিখুন (কমপক্ষে ১০ অক্ষর):');if(!newPassword)return;try{const d=await api('/api/auth/password-reset/confirm',{method:'POST',body:JSON.stringify({token:raw,newPassword})});$('authStatus').textContent=d.message||'Password reset successful.';}catch(e){$('authStatus').textContent=e.message;}}
async function saveProfile(){if(!needLogin())return;try{const d=await api('/api/auth/profile',{method:'PATCH',body:JSON.stringify({name:$('profileName').value,className:$('profileClass').value,school:$('profileSchool').value})});user=d.user;userUI();$('profileStatus').textContent='Profile saved.';}catch(e){$('profileStatus').textContent=e.message;}}
async function changePassword(){if(!needLogin())return;try{await api('/api/auth/change-password',{method:'POST',body:JSON.stringify({oldPassword:$('oldPass').value,newPassword:$('newPass').value})});$('passwordStatus').textContent='Password changed.';}catch(e){$('passwordStatus').textContent=e.message;}}
function addMsg(role,text){const d=document.createElement('div');d.className='msg '+(role==='user'?'user':'ai');d.textContent=text;$('chatBox').appendChild(d);$('chatBox').scrollTop=$('chatBox').scrollHeight;}
async function sendAI(){if(!needLogin())return;const m=$('aiInput').value.trim();if(!m&&!pendingAttachments.length)return;const attachmentText=pendingAttachments.filter(a=>a.text).map(a=>'[Extracted from '+a.name+']\n'+a.text).join('\n\n');const prompt=[m,attachmentText].filter(Boolean).join('\n\n');const images=pendingAttachments.filter(a=>a.dataUrl).map(a=>({name:a.name,dataUrl:a.dataUrl}));$('aiInput').value='';addMsg('user',prompt||('[Attached '+images.length+' image(s)]'));chat.push({role:'user',content:prompt||'[image attachment]'});$('aiStatus').textContent='Utsab AI is thinking...';try{const d=await api('/api/ai/chat',{method:'POST',body:JSON.stringify({message:prompt||'Please describe and analyze the attached image(s) for learning.',language:$('aiLang').value,history:chat.slice(-8,-1),attachments:images})});lastAnswer=d.answer;chat.push({role:'assistant',content:d.answer});addMsg('assistant',d.answer);$('aiStatus').textContent='';pendingAttachments=[];renderAttachmentPreview();}catch(e){$('aiStatus').textContent=e.message;}}
async function loadChat(){if(!needLogin())return;try{const d=await api('/api/chat/history');chat=d.items.map(x=>({role:x.role,content:x.content}));$('chatBox').innerHTML='';chat.forEach(x=>addMsg(x.role,x.content));}catch(e){$('aiStatus').textContent=e.message;}}
async function clearChat(){if(!needLogin())return;try{await api('/api/chat/history',{method:'DELETE'});chat=[];$('chatBox').innerHTML='';$('aiStatus').textContent='Chat history cleared.';}catch(e){$('aiStatus').textContent=e.message;}}
function voiceInput(){const SR=window.SpeechRecognition||window.webkitSpeechRecognition;if(!SR)return $('aiStatus').textContent='Voice recognition is not supported by this browser.';const r=new SR();r.lang=$('aiLang').value==='Bengali'?'bn-BD':'en-US';r.onresult=e=>$('aiInput').value=e.results[0][0].transcript;r.onerror=()=> $('aiStatus').textContent='Voice permission or recognition failed.';r.start();}
function speakLast(){if(!lastAnswer)return $('aiStatus').textContent='No answer to read.';if(!window.speechSynthesis)return $('aiStatus').textContent='Text-to-speech is unsupported.';speechSynthesis.cancel();const u=new SpeechSynthesisUtterance(lastAnswer);u.lang=$('aiLang').value==='Bengali'?'bn-BD':'en-US';speechSynthesis.speak(u);}
function openAttachmentMenu(){const choice=prompt('Attachment type লিখুন: camera / gallery / file');if(!choice)return;const c=choice.trim().toLowerCase();if(c==='camera')$('cameraInput').click();else if(c==='gallery'||c==='image')$('galleryInput').click();else $('documentInput').click();}
async function handleAttachment(files){if(!files||!files.length)return;for(const f of Array.from(files)){if(f.size>4*1024*1024){$('aiStatus').textContent=f.name+' 4 MB সীমা ছাড়িয়েছে।';continue;}const item={name:f.name,type:f.type,text:'',dataUrl:''};if(f.type.startsWith('image/')){item.dataUrl=await new Promise((resolve,reject)=>{const r=new FileReader();r.onload=()=>resolve(String(r.result));r.onerror=reject;r.readAsDataURL(f);});}else if(f.type==='text/plain'||/\.(txt|md|csv|json|html|xml)$/i.test(f.name)){item.text=(await f.text()).slice(0,100000);}else if(f.type==='application/pdf'||/\.pdf$/i.test(f.name)){try{item.text=await extractPdfText(f);}catch(e){item.text='[PDF text extraction failed: '+e.message+'. You may need a PDF text extraction service.]';}}else{item.text='[File attached: '+f.name+'. Automatic extraction for this document format is not available in this build. Convert it to PDF/TXT or connect a document extraction service.]';}pendingAttachments.push(item);}renderAttachmentPreview();}
async function extractPdfText(file){if(!window.pdfjsLib){await new Promise((resolve,reject)=>{const sc=document.createElement('script');sc.src='https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js';sc.onload=resolve;sc.onerror=()=>reject(Error('PDF.js could not load'));document.head.appendChild(sc);});window.pdfjsLib.GlobalWorkerOptions.workerSrc='https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';}const bytes=await file.arrayBuffer(),pdf=await pdfjsLib.getDocument({data:bytes}).promise;let out='';for(let i=1;i<=Math.min(pdf.numPages,30);i++){const page=await pdf.getPage(i),content=await page.getTextContent();out+=content.items.map(x=>x.str).join(' ')+'\n';if(out.length>90000)break;}return out||'[No selectable text found; scanned PDF may require OCR.]';}
function renderAttachmentPreview(){const el=$('attachmentPreview');if(!pendingAttachments.length){el.hidden=true;el.innerHTML='';return;}el.hidden=false;el.innerHTML='<strong>Attached files</strong>'+pendingAttachments.map((a,i)=>'<div class="row"><span>'+esc(a.name)+'</span><button class="btn danger small" onclick="removeAttachment('+i+')">Remove</button></div>').join('');}
function removeAttachment(i){pendingAttachments.splice(i,1);renderAttachmentPreview();}
function filterChat(){const q=$('chatSearch').value.toLowerCase();Array.from($('chatBox').children).forEach(n=>n.hidden=!n.textContent.toLowerCase().includes(q));}
function saveQuestionBank(){const subject=$('qbSubject').value.trim(),question=$('qbQuestion').value.trim(),answer=$('qbAnswer').value.trim();if(!question)return alert('প্রশ্ন লিখুন।');const a=JSON.parse(localStorage.getItem('usbk_questionbank')||'[]');a.unshift({subject,question,answer,createdAt:new Date().toISOString()});localStorage.setItem('usbk_questionbank',JSON.stringify(a));$('qbQuestion').value='';$('qbAnswer').value='';renderQuestionBank();}
function renderQuestionBank(){const a=JSON.parse(localStorage.getItem('usbk_questionbank')||'[]');$('qbList').innerHTML=a.map((x,i)=>'<div class="item"><span class="pill">'+esc(x.subject||'General')+'</span><h3>'+esc(x.question)+'</h3><details><summary>Show answer</summary><p>'+esc(x.answer)+'</p></details><button class="btn danger small" onclick="deleteQuestionBank('+i+')">Delete</button></div>').join('')||'<p class="muted">No saved questions.</p>';}
function deleteQuestionBank(i){const a=JSON.parse(localStorage.getItem('usbk_questionbank')||'[]');a.splice(i,1);localStorage.setItem('usbk_questionbank',JSON.stringify(a));renderQuestionBank();}
function exportQuestionBank(){download('usbk-question-bank.json',JSON.stringify(JSON.parse(localStorage.getItem('usbk_questionbank')||'[]'),null,2),'application/json');}
async function tutorMode(mode){if(!needLogin())return;const prompt=promptText();if(!prompt)return $('modeStatus').textContent='আগে Utsab AI-তে প্রশ্ন লিখুন অথবা উপরের বিষয়/কাজটি লিখুন।';$('modeStatus').textContent='Generating...';try{const d=await api('/api/ai/tutor-mode',{method:'POST',body:JSON.stringify({mode,prompt,language:$('aiLang').value})});lastAnswer=d.answer;addMsg('assistant',d.answer);$('modeStatus').textContent='Ready.';show('ai');}catch(e){$('modeStatus').textContent=e.message;}}
function promptText(){return $('aiInput').value.trim()||$('studyTopic').value.trim()||$('examMistake').value.trim()||$('researchQ').value.trim();}
async function studyPack(){if(!needLogin())return;const topic=$('studyTopic').value.trim();if(!topic)return $('studyStatus').textContent='Topic required.';$('studyStatus').textContent='Generating...';try{const d=await api('/api/ai/study-pack',{method:'POST',body:JSON.stringify({topic,subject:$('studySubject').value,className:$('studyClass').value,language:$('aiLang').value==='Auto-detect'?'Bengali':$('aiLang').value})});$('studyOutput').textContent=d.answer;$('studyStatus').textContent='Ready.';}catch(e){$('studyStatus').textContent=e.message;}}
async function previousQuestions(){if(!needLogin())return;$('qStatus').textContent='Generating practice questions...';try{const d=await api('/api/ai/previous-questions',{method:'POST',body:JSON.stringify({subject:$('qSubject').value,className:$('qClass').value,exam:$('qExam').value,topic:$('qTopic').value,language:$('aiLang').value==='Auto-detect'?'Bengali':$('aiLang').value})});$('qOutput').textContent=d.answer;$('qStatus').textContent='Practice content only; not verified previous-year questions.';}catch(e){$('qStatus').textContent=e.message;}}
async function saveNote(){if(!needLogin())return;try{await api('/api/notes',{method:'POST',body:JSON.stringify({title:$('noteTitle').value,subject:$('noteSubject').value,content:$('noteContent').value})});$('notesStatus').textContent='Saved.';loadNotes();refreshDashboard();}catch(e){$('notesStatus').textContent=e.message;}}
async function loadNotes(){if(!user)return $('notesList').textContent='Log in to save notes.';try{const d=await api('/api/notes');$('notesList').innerHTML=d.items.map(n=>`<div class="item"><h3>${esc(n.title)}</h3><span class="pill">${esc(n.subject)}</span><p>${esc(n.content)}</p><button class="btn secondary small" onclick="deleteNote('${n.id}')">Delete</button></div>`).join('')||'<p class="muted">No notes.</p>';}catch(e){$('notesStatus').textContent=e.message;}}
