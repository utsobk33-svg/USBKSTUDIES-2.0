app.post("/api/research",authRequired,async(req,res,next)=>{
  try {
    const query=clampText(req.body.query,1000);
    if(!query)return res.status(400).json({error:"Enter a research question."});
    const key=process.env.WEB_SEARCH_API_KEY;
    if(!key){const e=new Error("Live Web Research needs WEB_SEARCH_API_KEY in Render Environment Variables. Set it to a key from your chosen supported search provider.");e.status=503;throw e;}
    const base=(process.env.WEB_SEARCH_BASE_URL||"https://api.tavily.com").replace(/\/+$/,"");
    const endpoint=process.env.WEB_SEARCH_ENDPOINT||"/search";
    const url=base+(endpoint.startsWith("/")?endpoint:"/"+endpoint);
    const response=await fetch(url,{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({api_key:key,query,search_depth:process.env.WEB_SEARCH_DEPTH||"basic",max_results:Math.min(10,Math.max(1,Number(req.body.maxResults)||5)),include_answer:true,include_raw_content:false}),signal:AbortSignal.timeout(Math.max(5000,Number(process.env.WEB_SEARCH_TIMEOUT_MS)||20000))});
    const raw=await response.text();let data={};try{data=JSON.parse(raw)}catch{}
    if(!response.ok){const e=new Error(data?.message||data?.detail||`Search provider returned HTTP ${response.status}. Check WEB_SEARCH_BASE_URL/ENDPOINT and provider API format.`);e.status=502;throw e;}
    const results=(Array.isArray(data.results)?data.results:[]).map(x=>({title:clampText(x.title,500),url:clampText(x.url,2000),content:clampText(x.content||x.snippet,4000),score:Number(x.score)||null})).filter(x=>x.url);
    res.json({query,answer:clampText(data.answer,6000),results,provider:"configured web search",checkedAt:new Date().toISOString()});
  }catch(e){next(e);}
});

