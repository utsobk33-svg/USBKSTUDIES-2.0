services:
  - type: web
    name: usbkstudies-26-7-1
    runtime: node
    plan: free
    buildCommand: npm install
    startCommand: npm start
    healthCheckPath: /api/health
    envVars:
      - key: NODE_ENV
        value: production
      - key: JWT_SECRET
        generateValue: true
      - key: DATABASE_URL
        sync: false
      - key: GROW_API_KEY
        sync: false
      - key: GROW_API_BASE_URL
        sync: false
      - key: GROW_API_ENDPOINT
        value: /chat/completions
      - key: GROW_API_MODEL
        sync: false
      - key: GOOGLE_CSE_API_KEY
        sync: false
      - key: GOOGLE_CSE_CX
        sync: false
      - key: WEB_SEARCH_API_KEY
        sync: false
      - key: WEB_SEARCH_BASE_URL
        sync: false

      - key: WEB_SEARCH_ENDPOINT
        value: /search
      - key: SMTP_HOST
        sync: false
      - key: SMTP_PORT
        value: "587"
      - key: SMTP_SECURE
        value: "false"
      - key: SMTP_USER
        sync: false
      - key: SMTP_PASS
        sync: false
      - key: MAIL_FROM
        sync: false
      - key: APP_BASE_URL
        sync: false
      - key: AI_REQUEST_TIMEOUT_MS
        value: "45000"
      - key: WEB_SEARCH_TIMEOUT_MS
        value: "20000"
